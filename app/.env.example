PROJECT_NAME="Студия дизайна «Грея душу»"
# Локально используем SQLite, на сервере заменим на postgresql+asyncpg://user:pass@localhost/dbname
DATABASE_URL="sqlite+aiosqlite:///./greydushy.db"

# Токены (заполним на следующих этапах)
TG_BOT_TOKEN="your_telegram_bot_token"
VK_GROUP_TOKEN="your_vk_group_token"
MAX_BOT_TOKEN="your_max_bot_token"

# Настройки вашего почтового API
EMAIL_API_URL="https://api.greydushy.com/webhook"
EMAIL_API_KEY="secret_api_key"

# Ключ Яндекс.Карт (для геокодирования адреса и отрисовки карты в Mini App)
YANDEX_MAPS_API_KEY="your_yandex_maps_js_api_key"

# Обязательные документы студии
PRIVACY_POLICY_URL="https://greydushy.com/privacy.pdf"
PRIVACY_AGREEMENT_URL="https://greydushy.com/privacy_agreement.pdf"
SAFETY_PRECAUTIONS_URL="https://greydushy.com/safety_precautions.pdf"
